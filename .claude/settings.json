      "Bash(git push * --force:*)",
      "Bash(git push * -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore --:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc --prune:*)",
      "Bash(sudo:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo install:*)",
      "Bash(cargo yank:*)",
      "Bash(cargo owner:*)",
      "Bash(cargo login:*)",
      "Bash(cargo logout:*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(.git/**)",
      "Read(**/*.pem)",
