// 1D harmonic oscillator: H(q, p) = p^2 / (2m) + (1/2) k q^2.
// Demonstrates unit-annotated function signatures and the precedence rule
// `-x^2 == -(x^2)` that the parser enforces.

function hamiltonian(q: Scalar<m>, p: Scalar<kg*m/s>, m: Scalar<kg>, k: Scalar<kg/s^2>): Scalar<kg*m^2/s^2>
  return p^2 / (2.0 * m) + 0.5 * k * q^2
end

let m: Scalar<kg> = 1.0
let k: Scalar<kg/s^2> = 4.0
let q0: Scalar<m> = 1.0
let p0: Scalar<kg*m/s> = 0.0
let h0: Scalar<kg*m^2/s^2> = hamiltonian(q0, p0, m, k)
